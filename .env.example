# Public site URL (used for SEO metadata, robots, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — copy to .env.local and fill from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (webhooks, admin jobs). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Coach (server-only)
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=

# Contact form email delivery (server-side)
# Recommended: free key from https://resend.com (100 emails/day)
RESEND_API_KEY=
# Optional custom sender after domain verification, e.g. "Coach Online <hello@yourdomain.com>"
RESEND_FROM=
# Where inquiries arrive (defaults to founder email in src/lib/founder.ts)
CONTACT_EMAIL=

# Stripe (post-MVP)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
