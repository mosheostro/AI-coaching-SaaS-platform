# Public site URL (used for SEO metadata, robots, sitemap, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — copy to .env.local and fill from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (webhooks, admin jobs). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Coach (server-only)
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=

# Contact form email delivery (server-side)
# Recommended: free key from https://resend.com (100 emails/day)
RESEND_API_KEY=
# Optional custom sender after domain verification, e.g. "Coach Online <hello@yourdomain.com>"
RESEND_FROM=
# Where inquiries arrive (defaults to founder email in src/lib/founder.ts)
CONTACT_EMAIL=

# Cloudflare Turnstile (bot protection on auth forms)
# Create a free widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public; the secret key goes into Supabase Auth -> Bot protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Dev/test keys that always pass:
#   site:   1x00000000000000000000AA
#   secret: 1x0000000000000000000000000000000AA

# Stripe (post-MVP)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
